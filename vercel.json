{
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,config_phone.json,config_linux.json,config_windows.json,momo.json}"
    }
  },
  "rewrites": [
    { "source": "/sub", "destination": "/api/sub" },
    { "source": "/sub/", "destination": "/api/sub" },
    { "source": "/s/:id", "destination": "/api/s/:id" }
  ]
}
